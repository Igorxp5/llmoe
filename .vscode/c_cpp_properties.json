{
  "configurations": [
    {
      "name": "Linux",
      "includePath": [
        "${workspaceFolder}",
        "${workspaceFolder}/src",
        "${workspaceFolder}/vendor/iree/runtime/src",
        "${workspaceFolder}/vendor/iree/third_party/flatcc/include"
      ],
      "defines": [
        "IREE_ALLOCATOR_SYSTEM_CTL=iree_allocator_libc_ctl",
        "_POSIX_C_SOURCE=200112L",
        "_DEFAULT_SOURCE=1"
      ],
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "c99",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ],
  "version": 4
}
